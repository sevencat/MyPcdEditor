<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MyPcdEditor.App.Controls"
        x:Class="MyPcdEditor.App.Views.MainWindow"
        Title="MyPcdEditor — 点云 / 栅格地图"
        Width="1360" Height="860"
        MinWidth="900" MinHeight="600"
        Background="#101215"
        FontFamily="{StaticResource ContentControlThemeFontFamily}">

  <DockPanel LastChildFill="True">

    <Border DockPanel.Dock="Top" Background="#181C22" Padding="10,8" BorderBrush="#262B33" BorderThickness="0,0,0,1">
      <!-- 工具栏分两行：上行是「打开 / 视图参数 / 显示开关」，下行是「编辑与处理」。
           窄窗口时整块仍可横向滚动，不至于把最右边的开关挤没 -->
      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <StackPanel Orientation="Vertical" Spacing="8">

          <!-- 第一行：打开文件、视图参数、显示开关 -->
          <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <Button x:Name="OpenButton" Content="打开地图包…" Click="OnOpenClick" />
            <Button x:Name="FitButton" Content="适配视图 (F)" Click="OnFitClick" />
            <Button x:Name="ResetButton" Content="复位 (R)" Click="OnResetClick" />

            <Border Width="1" Background="#2A303A" Margin="4,2" />

            <TextBlock Text="着色" VerticalAlignment="Center" Opacity="0.75" />
            <ComboBox x:Name="ColorModeBox" SelectedIndex="0" Width="110">
              <ComboBoxItem Content="高度" />
              <ComboBoxItem Content="单色" />
            </ComboBox>

            <TextBlock Text="点大小" VerticalAlignment="Center" Opacity="0.75" />
            <Slider x:Name="PointSizeSlider" Minimum="0.5" Maximum="8" Value="1.6" Width="150" VerticalAlignment="Center" />

            <TextBlock Text="细节" VerticalAlignment="Center" Opacity="0.75" />
            <ComboBox x:Name="DetailBox" SelectedIndex="0" Width="110" ToolTip.Tip="点数多时降密度换取帧率：点云按空间均匀抽样，不会只显示一部分">
              <ComboBoxItem Content="全部" />
              <ComboBoxItem Content="1/2" />
              <ComboBoxItem Content="1/4" />
              <ComboBoxItem Content="1/8" />
            </ComboBox>

            <Border Width="1" Background="#2A303A" Margin="4,2" />

            <ToggleButton x:Name="MapToggle" Content="2D 地图" IsChecked="True" Click="OnMapToggleClick" />
            <CheckBox x:Name="OverlayCheck" Content="叠加点云" IsChecked="True" VerticalAlignment="Center" />
            <CheckBox x:Name="GroundCheck" Content="地面纹理" IsChecked="True" VerticalAlignment="Center" />
          </StackPanel>

          <!-- 第二行：编辑与处理 -->
          <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <Button x:Name="OptimizeButton" Content="优化 ▾" ToolTip.Tip="对当前点云 / 栅格做算子处理，处理结果直接替换视图中的数据（原始文件不动）">
              <Button.Flyout>
                <MenuFlyout>
                  <MenuItem Header="点云 · 体素降采样…" Click="OnVoxelDownsampleClick" />
                  <MenuItem Header="点云 · 统计去噪 (SOR)…" Click="OnOutlierRemovalClick" />
                  <MenuItem Header="点云 · 按范围裁剪…" Click="OnCropClick" />
                  <Separator />
                  <MenuItem Header="栅格 · 去毛刺" Click="OnDespeckleClick" />
                  <MenuItem Header="栅格 · 补洞" Click="OnCloseHolesClick" />
                  <MenuItem Header="栅格 · 去孤岛…" Click="OnRemoveIslandsClick" />
                  <Separator />
                  <MenuItem Header="导出当前结果…" Click="OnExportClick" />
                  <MenuItem Header="替换当前地图包（覆盖原文件）…" Click="OnReplaceClick" />
                  <MenuItem Header="撤销全部优化（重新加载）" Click="OnRevertClick" />
                </MenuFlyout>
              </Button.Flyout>
            </Button>

            <Button x:Name="UndoButton" Content="撤销 (Ctrl+Z)" IsEnabled="False" Click="OnUndoClick"
                    ToolTip.Tip="撤销最近一次编辑（框选 / 笔刷 / 栅格擦除 / 优化）。重新加载或合并之后历史会清空" />

            <Border Width="1" Background="#2A303A" Margin="4,2" />

            <Button x:Name="MergeButton" Content="合并 ▾"
                    ToolTip.Tip="把另一个地图包并进当前包：先按 .projected_origin 锚点定初值，再用点云 ICP 精配准，最后拼接点云与栅格">
              <Button.Flyout>
                <MenuFlyout>
                  <MenuItem Header="合并另一个地图包…" Click="OnMergeClick" />
                  <MenuItem x:Name="ReportMenuItem" Header="查看上次对齐报告…" IsEnabled="False" Click="OnReportClick" />
                </MenuFlyout>
              </Button.Flyout>
            </Button>
            <Button x:Name="CancelMergeButton" Content="取消合并" IsVisible="False" Click="OnCancelMergeClick" />

            <Border Width="1" Background="#2A303A" Margin="4,2" />

            <ToggleButton x:Name="BoxSelectToggle" Content="框选 (B)"
                          ToolTip.Tip="打开后用左键拖出矩形：框内的点会被删掉（Shift + 拖 = 只保留框内）。原始文件不动，重新加载即可撤销" />

            <ToggleButton x:Name="BrushToggle" Content="笔刷 (E)"
                          ToolTip.Tip="打开后按住左键涂抹：涂到的点会被删掉。E 切换模式，右边滑块调半径；原始文件不动，重新加载即可撤销" />
            <Slider x:Name="BrushSizeSlider" Minimum="4" Maximum="160" Value="32" Width="110"
                    VerticalAlignment="Center" ToolTip.Tip="笔刷半径（像素，3D 笔刷与 2D 栅格擦除共用）" />

            <ToggleButton x:Name="GridEraseToggle" Content="栅格擦除 (G)"
                          ToolTip.Tip="打开后在右侧 2D 地图上按住左键涂抹：刷到的像素改成未知（勾选「擦成空闲」则刷成空闲）。右键平移、滚轮缩放；原始文件不动，重新加载即可撤销" />
            <CheckBox x:Name="GridEraseFreeCheck" Content="擦成空闲" VerticalAlignment="Center"
                      ToolTip.Tip="勾选 = 刷成空闲（254）；不勾 = 刷成未知（205）" />
          </StackPanel>

        </StackPanel>
      </ScrollViewer>
    </Border>

    <Border DockPanel.Dock="Bottom" Background="#181C22" Padding="10,6" BorderBrush="#262B33" BorderThickness="0,1,0,0">
      <TextBlock x:Name="StatusText" Text="就绪：从「打开地图包…」选择一个包含 pcd / pgm / yaml 的目录 · 左键拖动微调视角、滚轮缩放、右键平移" FontSize="12" Opacity="0.85" TextWrapping="Wrap" />
    </Border>

    <Grid x:Name="ContentGrid" ColumnDefinitions="3*,4,2*">
      <Grid Grid.Column="0">
        <controls:PointCloudView x:Name="View" />
        <!-- 框选矩形与笔迹画在上面一层：GL 视图里画 2D 图形要另写一套着色器，Avalonia 的形状更省事 -->
        <Canvas x:Name="SelectionCanvas" IsHitTestVisible="False">
          <Rectangle x:Name="SelectionRect" IsVisible="False"
                     Stroke="#FFB020" StrokeThickness="1.5" Fill="#40FFB020" />
          <!-- 笔迹用粗折线画：圆头 + 圆角，几何上正好是 Core 里判定的「折线胶囊」 -->
          <Polyline x:Name="BrushStroke" IsVisible="False" Stroke="#FF6B4A" StrokeThickness="64"
                    StrokeLineCap="Round" StrokeJoin="Round" Opacity="0.45" />
          <Ellipse x:Name="BrushCursor" IsVisible="False" Stroke="#FF6B4A" StrokeThickness="1.5"
                   Fill="#18FF6B4A" />
        </Canvas>
      </Grid>

      <GridSplitter x:Name="MapSplitter" Grid.Column="1" ResizeDirection="Columns" Background="#262B33" />

      <DockPanel x:Name="MapPanel" Grid.Column="2" Background="#12151A">
        <Border DockPanel.Dock="Top" Background="#181C22" Padding="10,8" BorderBrush="#262B33" BorderThickness="0,0,0,1">
          <StackPanel Spacing="6">
            <TextBlock Text="2D 栅格地图" FontWeight="SemiBold" Opacity="0.9" />

            <!-- 图例颜色必须与 OccupancyPalette 的常量一致 -->
            <StackPanel Orientation="Horizontal" Spacing="12">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <Border Width="10" Height="10" Background="#E8ECF2" VerticalAlignment="Center" />
                <TextBlock Text="占用" FontSize="11" Opacity="0.8" VerticalAlignment="Center" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="4">
                <Border Width="10" Height="10" Background="#4A505C" VerticalAlignment="Center" />
                <TextBlock Text="未知" FontSize="11" Opacity="0.8" VerticalAlignment="Center" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="4">
                <Border Width="10" Height="10" Background="#1E2228" VerticalAlignment="Center" />
                <TextBlock Text="空闲" FontSize="11" Opacity="0.8" VerticalAlignment="Center" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="4">
                <Border Width="10" Height="10" Background="#FF7A18" VerticalAlignment="Center" />
                <TextBlock Text="点云投影" FontSize="11" Opacity="0.8" VerticalAlignment="Center" />
              </StackPanel>
            </StackPanel>

            <TextBlock x:Name="MapCursorText" Text="光标：—" FontSize="11" Opacity="0.7" />
          </StackPanel>
        </Border>

        <controls:MapView x:Name="Map" />
      </DockPanel>
    </Grid>

  </DockPanel>
</Window>
